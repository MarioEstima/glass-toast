{
  "name": "glass-toast",
  "version": "0.4.3",
  "description": "A lightweight toast notification library for React Native — monochrome pill toasts with action buttons, animated icons, light/dark themes and full customization (sizes, fonts, animations, layout).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "RELEASE-0.4.2.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "toast",
    "notifications",
    "glass",
    "snackbar",
    "expo",
    "dark-mode",
    "reanimated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarioEstima/glass-toast.git"
  },
  "bugs": {
    "url": "https://github.com/MarioEstima/glass-toast/issues"
  },
  "homepage": "https://github.com/MarioEstima/glass-toast#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-reanimated": ">=3.17.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.8",
    "react-native": "^0.87.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-svg": "^15.15.5",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "lucide-react-native": "^1.49.0"
  }
}
